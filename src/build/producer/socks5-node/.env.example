# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, ipv4/.env.example, peer/.env.example, stun/.env.example, socks5/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=easytier

# Docker image
IMAGE=easytier/easytier:latest
CONTAINER_NAME=easytier

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

TZ=Etc/UTC

ET_DEV_NAME=tun0

ET_NETWORK_NAME=easytier
ET_NETWORK_SECRET=XkQ6DuvzYtEe1TjCCKOFC697rCIhpyEx

ET_RPC_PORTAL=0

# sudo ufw allow 11010:11012/tcp
# sudo ufw allow 11010:11012/udp
ET_LISTENERS=11010

ET_DEFAULT_PROTOCOL=wss

# Private mode
ET_PRIVATE_MODE=true

# Enable Exit Node
ET_ENABLE_EXIT_NODE=false

# Optional
COMPOSE_FILE=docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.exit-nodes.yml:docker-compose.port-forward.yml

# Exit Nodes
T_EXIT_NODES=10.144.144.5,10.144.144.3

# Port Forward
ET_PORT_FORWARD=udp://0.0.0.0:14015/10.126.126.1:14015
# IPv4
ET_IPV4=10.144.144.1
# Peer

EASYTIER_PROTOCOL=tcp
EASYTIER_PUBLIC_IP=
EASYTIER_PORT=11010

ET_PEERS=${EASYTIER_PROTOCOL:-tcp}://${EASYTIER_PUBLIC_IP}:${EASYTIER_PORT:-11010}
# Stun Server
ET_STUN_SERVERS=1.2.3.4:3478
ET_STUN_SERVERS_V6=::ffff:102:304:3478

# ET_STUN_SERVERS=stun.example.com:3478
# ET_STUN_SERVERS_V6=stun-v6.example.com:3478
# Socks5
## for all interaface (suitable for nodes behind NAT)
# sudo ufw allow 1080/tcp
# sudo ufw allow 1080/udp

## for easy-tier interface (tun0) suitable for server node
## get interfaces list: ip a
# sudo ufw allow in on tun0 to any port 1080
ET_SOCKS5=1080