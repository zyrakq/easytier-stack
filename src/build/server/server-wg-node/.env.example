# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=easytier

# Docker image
IMAGE=easytier/easytier:latest
CONTAINER_NAME=easytier

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

ET_NETWORK_NAME=easytier
ET_NETWORK_SECRET=XkQ6DuvzYtEe1TjCCKOFC697rCIhpyEx

ET_RPC_PORTAL=0

# sudo ufw allow 11010:11012/tcp
# sudo ufw allow 11010:11012/udp
ET_LISTENERS=11010

ET_DEFAULT_PROTOCOL=wss

# Private mode
ET_PRIVATE_MODE=true

# Enable Exit Node
ET_ENABLE_EXIT_NODE=false

# Optional
COMPOSE_FILE=docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.exit-nodes.yml:docker-compose.port-forward.yml

# Exit Nodes
T_EXIT_NODES=10.144.144.5,10.144.144.3

# Port Forward
ET_PORT_FORWARD=udp://0.0.0.0:14015/10.126.126.1:14015
# IPv4
